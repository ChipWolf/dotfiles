{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash

# -e: exit on error
# -u: exit on unset variables
set -eu

if command -v brew >/dev/null 2>&1; then
  if [ -n "${CODESPACES:-}" ] || [ -n "${CI:-}" ] || [ -n "${HOMEBREW_CI:-}" ]; then
    exit 0
  fi

  BREWFILE_RENDERED="$(mktemp)"
  trap 'rm -f "$BREWFILE_RENDERED"' EXIT INT TERM
  cat >"$BREWFILE_RENDERED" <<'EOF'
{{ includeTemplate "Brewfile.tmpl" . }}
EOF
  {{ includeTemplate "brew-trust-declared.sh.tmpl" . | nindent 2 }}
  trust_declared_brew_tap_packages "$BREWFILE_RENDERED"

  brew update
  brew doctor || true
  # Homebrew 6 makes ask mode the default for install/upgrade/reinstall, which
  # blocks this unattended apply on a [y/n] prompt. --no-ask restores the old
  # behaviour (see `brew upgrade --help`, HOMEBREW_NO_ASK).
  brew upgrade --no-ask --cask --greedy
  brew upgrade --no-ask --greedy
  brew outdated --cask --greedy --verbose
  brew outdated --greedy --verbose
  brew cleanup
fi
{{- end }}
